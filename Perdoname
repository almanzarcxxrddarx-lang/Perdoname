<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta charset="UTF-8">
<title>Perdóname, mi Bebita</title>
<style>
  body {
    margin: 0;
    padding: 0;
    font-family: 'Arial', sans-serif;
    text-align: center;
    background-color: #ffe6f0;
    color: #d63384;
    overflow: hidden;
  }

  /* Fondo Hello Kitty */
  body::before {
    content: "";
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: url('https://i.imgur.com/5X6t1fJ.png');
    background-size: 200px;
    background-repeat: repeat;
    opacity: 0.2;
    z-index: -1;
  }

  .carta {
    background-color: #fff0f5;
    border: 2px solid #d63384;
    border-radius: 20px;
    padding: 30px;
    max-width: 600px;
    margin: 100px auto;
    box-shadow: 0 8px 20px rgba(0,0,0,0.2);
    position: relative;
    z-index: 1;
  }

  h1 {
    color: #ff66a3;
  }

  button {
    font-size: 1.2em;
    margin: 10px;
    padding: 10px 20px;
    border-radius: 10px;
    border: none;
    cursor: pointer;
  }

  .si { background-color: #ff66a3; color: white; }
  .no { background-color: #d63384; color: white; }

  p {
    font-size: 1.3em;
    margin-top: 20px;
  }

  /* Corazón que crece */
  #corazon {
    font-size: 50px;
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) scale(1);
    opacity: 0;
    transition: transform 0.5s ease, opacity 0.5s ease;
    z-index: 2;
  }

  .latir {
    animation: latido 1s infinite alternate;
  }

  @keyframes latido {
    0% { transform: translate(-50%, -50%) scale(1); }
    50% { transform: translate(-50%, -50%) scale(1.5); }
    100% { transform: translate(-50%, -50%) scale(1); }
  }
</style>
</head>
<body>
  <div class="carta">
    <h1>Mi amoooorrr 💖</h1>
    <p>¿Me perdonas, mi bebita linda? 💔</p>
    <button class="si" onclick="perdonar()">Sí 💕</button>
    <button class="no" onclick="noPerdonar()">No 😢</button>
    <p id="respuesta"></p>
  </div>

  <div id="corazon">💖</div>

<script>
const mensajesNo = [
  "Me perdonas 😢💔",
  "Porfavooorr, perdonameeee 💔💖",
  "Te pidooo perdonnn, te lo ruego 💔💖",
  "Ándale chiiii 😭💕",
  "Mi bebitaaa linda, porfaaaaa 😢💖",
  "Amorcitoo 💔💔💔",
  "Mi corazoncitooo 💔💔💔",
  "Dice Jennie Kim que me perdones 😭💖"
];

let intento = 0;

function perdonar() {
  document.getElementById('respuesta').innerHTML = "¡Yupiiiiiiiii! Gracias, mi amorcito hermosoooooooo 😍💖";
  // Ocultar el corazón
  const corazon = document.getElementById('corazon');
  corazon.style.opacity = 0;
  corazon.classList.remove('latir');
}

function noPerdonar() {
  if(intento < mensajesNo.length){
    document.getElementById('respuesta').innerHTML = mensajesNo[intento];
    intento++;
  } else {
    // Si se pasa del último mensaje, repetir el último
    document.getElementById('respuesta').innerHTML = mensajesNo[mensajesNo.length-1];
  }
  
  // Hacer que el corazón aparezca y lata
  const corazon = document.getElementById('corazon');
  corazon.style.opacity = 1;
  corazon.classList.add('latir');
}
</script>
</body>
</html>
